<h1><%= title %></h1>

<%- messages() %>

<% if (errors && errors.array) { %>
  <ul class="notice">
    <% errors.array().forEach(error => { %>
      <li><%= error.msg %></li>
    <% }) %>
  </ul>
<% } %>

<section class="account-login">
  <form class="login-form" id="loginForm" action="/account/login" method="post">
    <label for="account_email">Email</label>
    <input
      type="email"
      id="account_email"
      name="account_email"
      required
      autocomplete="email"
      placeholder="name@example.com"
      value="<%= typeof account_email !== 'undefined' ? account_email : '' %>"
    >

    <label for="account_password">Password</label>

    <p class="password-rules">
      Password must be at least 12 characters and contain at least 1 uppercase letter,
      1 lowercase letter, 1 number, and 1 special character.
    </p>

    <input
      type="password"
      id="account_password"
      name="account_password"
      required
      autocomplete="current-password"
      placeholder="Enter your password"
    >

    <button type="submit">Login</button>

    <div class="account-register">
      <p>No account? <a href="/account/register">Sign-up</a></p>
    </div>
  </form>
</section>
