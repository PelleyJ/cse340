<%- messages() %>

<h1><%= title %></h1>

<p>Confirm Deletion - The delete is permanent.</p>

<% if (errors && errors.length) { %>
  <ul class="errors">
    <% errors.forEach((e) => { %>
      <li><%= e.msg %></li>
    <% }) %>
  </ul>
<% } %>

<form action="/inv/delete" method="post">
  <label for="inv_make">Make</label>
  <input
    type="text"
    id="inv_make"
    name="inv_make"
    readonly
    value="<%= inv_make %>"
  >

  <label for="inv_model">Model</label>
  <input
    type="text"
    id="inv_model"
    name="inv_model"
    readonly
    value="<%= inv_model %>"
  >

  <label for="inv_year">Year</label>
  <input
    type="number"
    id="inv_year"
    name="inv_year"
    readonly
    value="<%= inv_year %>"
  >

  <label for="inv_price">Price</label>
  <input
    type="number"
    id="inv_price"
    name="inv_price"
    readonly
    value="<%= inv_price %>"
  >

  <!-- Hidden inv_id -->
  <input type="hidden" name="inv_id"
    <% if (locals.inv_id) { %> value="<%= locals.inv_id %>" <% } %>
  >

  <button type="submit">Delete</button>
</form>
