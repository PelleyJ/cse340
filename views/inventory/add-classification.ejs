<%- messages() %>

<h1><%= title %></h1>

<p><strong>Note:</strong> Classification names cannot contain spaces or special characters.</p>

<% if (errors && errors.length) { %>
  <ul class="errors">
    <% errors.forEach((e) => { %>
      <li><%= e.msg %></li>
    <% }) %>
  </ul>
<% } %>

<form action="/inv/add-classification" method="post">
  <label for="classification_name">Classification Name</label>
  <input
    type="text"
    id="classification_name"
    name="classification_name"
    required
    pattern="^[A-Za-z0-9]+$"
    maxlength="30"
    title="Letters and numbers only. No spaces or symbols."
    value="<%= classification_name %>"
  >
  <button type="submit">Add Classification</button>
</form>
