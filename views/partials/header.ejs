<header id="top-header">
  <span class="siteName">
    <a href="/" title="Return to home page">CSE Motors</a>
  </span>

  <div id="tools">
    <% if (locals.accountData) { %>
      <span>Welcome <%= locals.accountData.account_firstname %></span>
      |
      <a href="/account/logout" title="Logout">Logout</a>
    <% } else { %>
      <a href="/account/login" title="Click to log in">Login</a>
    <% } %>
  </div>
</header>
